# gub-research-worker — local/dev env. Copy to .env (gitignored).
#
# In Cloud Run these are injected from Secret Manager / env-vars by the
# cloudbuild deploy step; this file is only for `npm run dev` / `npm run queue`.

# Shared GUB database (same instance gub-admin / GUB use). The worker
# reads research_jobs + staff context and writes staff_research_dossiers.
DATABASE_URL=postgresql://user:pass@localhost:5432/gub_dev

# Perplexity API key. Used ONLY by this worker — never lands in gub-admin
# or GUB. Agent API bearer token.
PERPLEXITY_API_KEY=

# Hard ceiling for a single provider call before the worker aborts it,
# marks the job failed, and moves on. Seconds. Perplexity advanced-deep-
# research has a long tail; 900s (15m) is a sane default.
RESEARCH_CALL_TIMEOUT_S=900

# A `running` row older than this (seconds) is considered orphaned (the
# Job process died mid-call) and is reclaimed to `queued` at startup.
# Should be >= RESEARCH_CALL_TIMEOUT_S plus margin.
RESEARCH_STALE_RUNNING_S=1200

# Max concurrent provider calls per Job execution. Perplexity Tier 0 is
# ~5 rpm; deep-research latency (minutes) means concurrency, not rpm, is
# the real throttle. Start conservative.
RESEARCH_MAX_CONCURRENCY=3

# ── Ingestion script only (scripts/queue-deep-research.ts) ───────────────
# These are not needed by the Job itself.

# GCP project + region + job name, so the script can fire the Job via the
# Cloud Run Admin API after inserting rows.
GCP_PROJECT_ID=os-test-491819
GCP_REGION=us-central1
RESEARCH_JOB_NAME=gub-research-worker-dev
